{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Gemini": {
    "ApiKey": "",
    "ApiKeyFile": "gemini.key",
    "Model": "gemini-3.8-flash",
    "Models": [ "gemini-3.8-flash", "gemini-3.7-flash" ],
    "BaseUrl": "https://generativelanguage.googleapis.com",
    "MaxRepairRounds": 3,
    "TimeoutSeconds": 300,
    "Temperature": 0.2,
    "MaxOutputTokens": 32768,

    "Candidates": 1,
    "PolishRounds": 1,
    "CompareRounds": 1,
    "ThinkingLevels": [ "low", "medium", "high" ],
    "ThinkingLevel": "medium",
    "ReviseThinkingLevel": "medium",
    "RepairThinkingLevel": "high",
    "CompareThinkingLevel": "low",
    "RepairTemperature": 0.2,

    "ShotSlots": 9000,
    "ImageMaxPx": 1024,
    "ImageQuality": 0.90,
    "ShotMediaResolution": "MEDIA_RESOLUTION_ULTRA_HIGH",
    "ImageMediaResolution": "MEDIA_RESOLUTION_HIGH",

    "InputPricePerMTok": 0.75,
    "CachedInputPricePerMTok": 0.075,
    "OutputPricePerMTok": 3.75
  },

  "Node": {
    "Executable": "node"
  }
}
